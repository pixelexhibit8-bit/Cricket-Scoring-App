{
  "expo": {
    "name": "Cric Scorer",
    "slug": "basti",
    "scheme": "cricflowmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071B2C"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.cricscorer.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#071B2C",
        "foregroundImage": "./assets/logo.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "4b137f23-8eb7-47d5-8b9b-dccaa270b992"
      }
    },
    "owner": "bastixxxxs-team",
    "plugins": [
      "expo-splash-screen"
    ]
  }
}
